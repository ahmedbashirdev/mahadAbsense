// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String
  username      String        @unique
  password      String
  role          String        @default("STAFF") // "ADMIN" or "STAFF"
  // When true, this user is allowed to view/manage female students and their
  // attendance. ADMINs always have access. Toggleable from the users page.
  canViewFemale Boolean       @default(false)
  activityLogs  ActivityLog[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model AcademicYear {
  id        String    @id @default(cuid())
  name      String    // e.g., "السنة التمهيدية"
  order     Int       // Sorting order
  subjects  Subject[]
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Subject {
  id           String       @id @default(cuid())
  name         String
  termType     String       // "ONE_TERM" or "TWO_TERMS"
  yearId       String
  academicYear AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  attendances  Attendance[]
  // Lecturers who can teach this subject (M:N).
  lecturers    Lecturer[]   @relation("LecturerSubjects")
  // Concrete lecture instances scheduled for this subject.
  lectures     Lecture[]
  // Curriculum tracking
  bookName     String?      // The book assigned to this subject
  targetPage   Int?         // The page to reach by the end of the term
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Student {
  id           String       @id @default(cuid())
  name         String
  gender       String       @default("MALE") // "MALE" or "FEMALE"
  // Self-service login credentials. Either set by the student during self-
  // signup or by an admin from the students page.
  username     String?      @unique
  password     String?      // bcrypt-hashed
  // Admins can disable a student's account without deleting it. Disabled
  // accounts cannot log in.
  isActive     Boolean      @default(true)
  yearId       String
  academicYear AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  attendances  Attendance[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// Lecturers (instructors) who teach the subjects.
model Lecturer {
  id             String                 @id @default(cuid())
  name           String
  username       String?                @unique
  password       String?                // bcrypt-hashed
  // ADMIN-created lecturers default to APPROVED. Self-signup defaults to
  // PENDING and only logs in once an admin approves them.
  approvalStatus String                 @default("APPROVED") // "PENDING" | "APPROVED"
  isActive       Boolean                @default(true)
  // Subjects this lecturer is qualified to teach.
  subjects       Subject[]              @relation("LecturerSubjects")
  // Per-day availability responses.
  availabilities LecturerAvailability[]
  // Concrete scheduled lectures.
  lectures       Lecture[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

// A specific date on which lectures are held (e.g., Friday Nov 22 2025).
// Admin creates these; lecturers respond with availability per day.
model LectureDay {
  id             String                 @id @default(cuid())
  date           DateTime               @unique
  label          String?                // e.g., "بعد صلاة الجمعة"
  // Admin marks the schedule as published; this is what students see.
  isPublished    Boolean                @default(false)
  publishedAt    DateTime?
  notes          String?
  availabilities LecturerAvailability[]
  lectures       Lecture[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

// A lecturer's response for a specific lecture day.
model LecturerAvailability {
  id           String     @id @default(cuid())
  lecturerId   String
  lecturer     Lecturer   @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  lectureDayId String
  lectureDay   LectureDay @relation(fields: [lectureDayId], references: [id], onDelete: Cascade)
  status       String     @default("PENDING") // "PENDING" | "CONFIRMED" | "DECLINED"
  reason       String?    // Reason given when declining
  respondedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([lecturerId, lectureDayId])
}

// A specific scheduled lecture in the timetable.
model Lecture {
  id           String     @id @default(cuid())
  lectureDayId String
  lectureDay   LectureDay @relation(fields: [lectureDayId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lecturerId   String?
  lecturer     Lecturer?  @relation(fields: [lecturerId], references: [id], onDelete: SetNull)
  // Order within the day (1, 2, 3...). Admin sorts the day's lectures.
  order        Int        @default(1)
  // Free-form HH:MM strings; we don't bind to a specific timezone here.
  startTime    String
  endTime      String
  notes        String?
  // Lecturer's comment on what was covered in the syllabus for students
  syllabusProgress String?
  reachedPage      Int?     // The specific page the lecturer reached today
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Generic key/value settings for system-wide configuration
// (e.g., per-subject absence warning threshold).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Persistent Telegram link between a Mahad account and a Telegram chat. We
// only store the chat ID + display fields — DMing the user works as long as
// the chat ID is alive.
model TelegramSubscription {
  id        String   @id @default(cuid())
  // "STUDENT" | "LECTURER" | "STAFF"
  userType  String
  // student.id / lecturer.id / user.id
  refId     String
  // The same Telegram chat may be bound to multiple Mahad accounts (e.g., a
  // parent who manages two of their kids' accounts), so chatId is intentionally
  // NOT unique. Uniqueness is per-Mahad-account via the composite below.
  chatId    String
  // Snapshot of Telegram profile fields for display (the user might not have a username at all)
  username  String?
  firstName String?
  lastName  String?
  enabledAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userType, refId])
  @@index([chatId])
}

// Short-lived link codes used by the deep-link signup flow:
//   /me -> click "اربط Telegram"  -> server creates a code and returns
//   t.me/<bot>?start=<code>      -> Telegram opens, user hits Start
//   bot receives /start <code>   -> webhook resolves code -> binds chat ID
model TelegramLinkCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userType  String
  refId     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Attendance {
  id        String   @id @default(cuid())
  date      DateTime // Date without time component
  status    String   // "PRESENT", "ABSENT", "EXCUSED"
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, studentId, subjectId])
}
