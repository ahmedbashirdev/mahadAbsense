// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String
  username      String        @unique
  password      String
  role          String        @default("STAFF") // "ADMIN" or "STAFF"
  // When true, this user is allowed to view/manage female students and their
  // attendance. ADMINs always have access. Toggleable from the users page.
  canViewFemale Boolean       @default(false)
  activityLogs  ActivityLog[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model AcademicYear {
  id        String    @id @default(cuid())
  name      String    // e.g., "السنة التمهيدية"
  order     Int       // Sorting order
  subjects  Subject[]
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Subject {
  id           String       @id @default(cuid())
  name         String
  termType     String       // "ONE_TERM" or "TWO_TERMS"
  yearId       String
  academicYear AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  attendances  Attendance[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Student {
  id           String       @id @default(cuid())
  name         String
  identifier   String?      // e.g., Student ID Code
  gender       String       @default("MALE") // "MALE" or "FEMALE"
  // Self-service login credentials. Either set by the student during self-
  // signup or by an admin from the students page.
  username     String?      @unique
  password     String?      // bcrypt-hashed
  // Admins can disable a student's account without deleting it. Disabled
  // accounts cannot log in.
  isActive     Boolean      @default(true)
  yearId       String
  academicYear AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  attendances  Attendance[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// Generic key/value settings for system-wide configuration
// (e.g., per-subject absence warning threshold).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Attendance {
  id        String   @id @default(cuid())
  date      DateTime // Date without time component
  status    String   // "PRESENT", "ABSENT", "EXCUSED"
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, studentId, subjectId])
}
