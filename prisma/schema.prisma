// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String
  username      String        @unique
  password      String
  role          String        @default("STAFF") // "ADMIN" or "STAFF"
  // When true, this user is allowed to view/manage female students and their
  // attendance. ADMINs always have access. Toggleable from the users page.
  canViewFemale Boolean       @default(false)
  activityLogs  ActivityLog[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model AcademicYear {
  id        String    @id @default(cuid())
  name      String    // e.g., "السنة التمهيدية"
  order     Int       // Sorting order
  subjects  Subject[]
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Subject {
  id           String       @id @default(cuid())
  name         String
  termType     String       // "ONE_TERM" or "TWO_TERMS"
  yearId       String
  academicYear AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  attendances  Attendance[]
  // Lecturers who can teach this subject (M:N).
  lecturers    Lecturer[]   @relation("LecturerSubjects")
  // Concrete lecture instances scheduled for this subject.
  lectures     Lecture[]
  // Exams scheduled for this subject (one per term).
  exams        Exam[]
  // Curriculum tracking
  bookName     String?      // The book assigned to this subject
  targetPage   Int?         // The page to reach by the end of the term
  reachedPage  Int?         // The current page reached in the syllabus
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Student {
  id           String       @id @default(cuid())
  name         String
  gender       String       @default("MALE") // "MALE" or "FEMALE"
  // Self-service login credentials. Either set by the student during self-
  // signup or by an admin from the students page.
  username     String?      @unique
  password     String?      // bcrypt-hashed
  // Admins can disable a student's account without deleting it. Disabled
  // accounts cannot log in.
  isActive     Boolean      @default(true)
  yearId       String
  academicYear AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  attendances  Attendance[]
  examResults  ExamResult[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// Lecturers (instructors) who teach the subjects.
model Lecturer {
  id             String                 @id @default(cuid())
  name           String
  username       String?                @unique
  password       String?                // bcrypt-hashed
  // ADMIN-created lecturers default to APPROVED. Self-signup defaults to
  // PENDING and only logs in once an admin approves them.
  approvalStatus String                 @default("APPROVED") // "PENDING" | "APPROVED"
  isActive       Boolean                @default(true)
  // Subjects this lecturer is qualified to teach.
  subjects       Subject[]              @relation("LecturerSubjects")
  // Per-day availability responses.
  availabilities LecturerAvailability[]
  // Concrete scheduled lectures.
  lectures       Lecture[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

// A specific date on which lectures are held (e.g., Friday Nov 22 2025).
// Admin creates these; lecturers respond with availability per day.
model LectureDay {
  id             String                 @id @default(cuid())
  date           DateTime               @unique
  label          String?                // e.g., "بعد صلاة الجمعة"
  // Admin marks the schedule as published; this is what students see.
  isPublished    Boolean                @default(false)
  publishedAt    DateTime?
  notes          String?
  availabilities LecturerAvailability[]
  lectures       Lecture[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

// A lecturer's response for a specific lecture day.
model LecturerAvailability {
  id           String     @id @default(cuid())
  lecturerId   String
  lecturer     Lecturer   @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  lectureDayId String
  lectureDay   LectureDay @relation(fields: [lectureDayId], references: [id], onDelete: Cascade)
  status            String     @default("PENDING") // "PENDING" | "CONFIRMED" | "DECLINED"
  reason            String?    // Reason given when declining
  plannedSubjectIds String     @default("[]") // JSON array of subject IDs chosen via Telegram
  respondedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([lecturerId, lectureDayId])
}

// Short-lived session for multi-step Telegram bot interactions
// (e.g., lecturer selecting subjects after tapping "تأكيد الحضور")
model TelegramBotSession {
  id             String   @id @default(cuid())
  chatId         String
  availabilityId String
  selectedIds    String   @default("[]") // JSON array of selected subject IDs
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([chatId])
  @@index([availabilityId])
}

// A specific scheduled lecture in the timetable.
model Lecture {
  id           String     @id @default(cuid())
  lectureDayId String
  lectureDay   LectureDay @relation(fields: [lectureDayId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lecturerId   String?
  lecturer     Lecturer?  @relation(fields: [lecturerId], references: [id], onDelete: SetNull)
  // Free-text name for a substitute/guest lecturer who isn't a registered
  // Lecturer (e.g. the assigned lecturer apologised or is unavailable). Used
  // for display when lecturerId is null.
  lecturerName String?
  // Order within the day (1, 2, 3...). Admin sorts the day's lectures.
  order        Int        @default(1)
  // Free-form HH:MM strings; we don't bind to a specific timezone here.
  startTime    String
  endTime      String
  notes        String?
  // Lecturer's comment on what was covered in the syllabus for students
  syllabusProgress String?
  reachedPage      Int?     // The specific page the lecturer reached today
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Generic key/value settings for system-wide configuration
// (e.g., per-subject absence warning threshold).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Persistent Telegram link between a Mahad account and a Telegram chat. We
// only store the chat ID + display fields — DMing the user works as long as
// the chat ID is alive.
model TelegramSubscription {
  id        String   @id @default(cuid())
  // "STUDENT" | "LECTURER" | "STAFF"
  userType  String
  // student.id / lecturer.id / user.id
  refId     String
  // The same Telegram chat may be bound to multiple Mahad accounts (e.g., a
  // parent who manages two of their kids' accounts), so chatId is intentionally
  // NOT unique. Uniqueness is per-Mahad-account via the composite below.
  chatId    String
  // Snapshot of Telegram profile fields for display (the user might not have a username at all)
  username  String?
  firstName String?
  lastName  String?
  enabledAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userType, refId])
  @@index([chatId])
}

// Groups multiple accounts (across Student / Lecturer / User tables) that
// belong to the SAME human. An admin links them manually. Accounts sharing a
// personId can quick-switch between each other on the site and share a single
// Telegram chat (notifications for all of them arrive in one place).
model LinkedAccount {
  id        String   @id @default(cuid())
  // Accounts sharing this value are the same person.
  personId  String
  // "STUDENT" | "LECTURER" | "STAFF"
  userType  String
  // student.id / lecturer.id / user.id
  refId     String
  createdAt DateTime @default(now())

  // Each underlying account belongs to at most one person group.
  @@unique([userType, refId])
  @@index([personId])
}

// Short-lived link codes used by the deep-link signup flow:
//   /me -> click "اربط Telegram"  -> server creates a code and returns
//   t.me/<bot>?start=<code>      -> Telegram opens, user hits Start
//   bot receives /start <code>   -> webhook resolves code -> binds chat ID
model TelegramLinkCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userType  String
  refId     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Attendance {
  id        String   @id @default(cuid())
  date      DateTime // Date without time component
  status    String   // "PRESENT", "ABSENT", "EXCUSED"
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, studentId, subjectId])
}

// A scheduled exam for a subject. Subjects that span two terms have one exam
// per term (term = 1 or 2); one-term subjects have a single exam (term = 1).
model Exam {
  id        String       @id @default(cuid())
  subjectId String
  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term      Int          @default(1) // 1 = الترم الأول, 2 = الترم الثاني
  // "MIDTERM" (ميد ترم) or "FINAL" (اختبار نهائي / اختبار الترم)
  kind      String       @default("FINAL")
  title     String?      // optional label, e.g. "اختبار نهاية الترم"
  date      DateTime     // exam date
  startTime String?      // optional HH:MM
  endTime   String?      // optional HH:MM
  location  String?      // optional location/room
  maxScore  Float        @default(100) // النهاية العظمى
  passScore Float        @default(50)  // درجة النجاح (out of maxScore)
  results   ExamResult[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// A single student's result in an exam.
model ExamResult {
  id         String    @id @default(cuid())
  examId     String
  exam       Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score      Float     // الدرجة المحصلة
  notes      String?
  // Set when the student has been notified of this result via Telegram.
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([examId, studentId])
}
